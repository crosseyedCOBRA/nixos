# fish (with the rebuild/upgrade commands), starship and git.
{ lib, ... }:

{
  # Login shell (users.users.*.shell in ../configuration.nix), set up like
  # fish/config.fish in the Arch dotfiles. Completions from man pages are
  # generated by home-manager itself (programs.fish.generateCompletions).
  programs.fish = {
    enable = true;
    # mkAfter: after starship's init line, where it sat when this was all one
    # home.nix -- splitting the file changed home-manager's merge order.
    interactiveShellInit = lib.mkAfter ''
      set -g fish_greeting

      fastfetch
      echo
      echo
      echo
    '';
    # rebuild: apply the config in ~/nixos as-is (same pinned versions).
    # upgrade: bump every flake input in flake.lock (nixpkgs, home-manager,
    # quickshell, ...), rebuild with them, then update Flatpak apps too.
    # nix-flatpak only installs the apps listed in ../modules/packages.nix; it
    # doesn't update them on rebuild, hence the explicit flatpak update.
    # prune-snapshots [count]: show the oldest snapper snapshots (default 5)
    # of each config in ../modules/storage.nix and delete them only after a
    # y at the prompt. The newest 5 are always kept whatever the count, and
    # snapshot 0 is the live system, never a candidate.
    functions = {
      rebuild = "sudo nixos-rebuild switch --flake ~/nixos#nixos $argv";
      upgrade = ''
        nix flake update --flake ~/nixos
        and rebuild $argv
        and flatpak update -y
      '';
      prune-snapshots = ''
        set -l count 5
        if set -q argv[1]
            if not string match -qr '^[1-9][0-9]*$' -- $argv[1]
                echo "usage: prune-snapshots [count]   (default 5)" >&2
                return 1
            end
            set count $argv[1]
        end
        sudo -v; or return 1

        for config in root home
            set -l all (sudo snapper --csvout --no-headers --separator '|' -c $config list --columns number,date,description | string match -rv '^0\|')
            set -l max (math (count $all) - 5)
            if test $max -le 0
                echo "$config: only "(count $all)" snapshots, keeping the newest 5"
                continue
            end
            set -l rows $all[1..(math "min($count, $max)")]
            echo "$config: oldest "(count $rows)" snapshots"
            for row in $rows
                printf '  #%-5s %s  %s\n' (string split -m 2 '|' -- $row)
            end
            read -l -P "Delete these $config snapshots? [y/N] " reply
            if string match -qi y -- $reply
                sudo snapper -c $config delete (string split -f 1 '|' -- $rows)
                and echo "$config: deleted"
            else
                echo "$config: skipped"
            end
        end
      '';
    };
  };

  # Prompt. No settings here on purpose: ~/.config/starship.toml is
  # generated by matugen from the wallpaper (../hyprland/matugen/templates/
  # starship.toml), and home-manager only writes that file when settings
  # are given. enableFishIntegration (on by default) adds the
  # `starship init fish | source` line.
  programs.starship.enable = true;

  programs.git = {
    enable = true;
    settings.user = {
      name = "crosseyedCOBRA";
      email = "crosseyedcobra@gmail.com";
    };
    # Signs commits with the GitHub SSH key (install.sh says how to make it).
    # GitHub only shows them as Verified once the same key is also added there
    # as a *signing* key, not just an authentication one.
    signing = {
      format = "ssh";
      key = "~/.ssh/id_ed25519.pub";
      signByDefault = true;
    };
  };
}
