// Generated by matugen from the current wallpaper -- do not edit by
// hand, regenerated on every login/wallpaper change (see
// ../../../home.nix's apply-colors/wallpaper-picker/random-wallpaper
// scripts). Edit this template instead. Same 4-hue-family + neutral
// structure as the original static config (blue/purple/pink/orange),
// just sourced from matugen's primary/secondary/tertiary/error roles
// instead of hardcoded hex.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "color": {
            "1": "{{colors.primary.dark.hex}}",
            "2": "{{colors.tertiary.dark.hex}}"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "{{colors.outline.dark.hex}}",
            "title": "{{colors.primary.dark.hex}}",
            "output": "{{colors.on_background.dark.hex}}",
            "separator": "{{colors.outline_variant.dark.hex}}"
        },
        "bar": {
            "width": 12,
            "char": {
                "elapsed": "■",
                "total": "░"
            }
        }
    },
    "modules": [
        { "type": "title", "color": { "user": "{{colors.primary.dark.hex}}", "at": "{{colors.outline.dark.hex}}", "host": "{{colors.tertiary.dark.hex}}" } },
        "separator",
        { "type": "os", "keyColor": "{{colors.primary.dark.hex}}" },
        { "type": "host", "keyColor": "{{colors.primary.dark.hex}}" },
        { "type": "kernel", "keyColor": "{{colors.tertiary.dark.hex}}" },
        { "type": "uptime", "keyColor": "{{colors.tertiary.dark.hex}}" },
        { "type": "packages", "keyColor": "{{colors.error.dark.hex}}" },
        { "type": "shell", "keyColor": "{{colors.error.dark.hex}}" },
        "break",
        { "type": "wm", "keyColor": "{{colors.secondary.dark.hex}}" },
        { "type": "terminal", "keyColor": "{{colors.secondary.dark.hex}}" },
        { "type": "cpu", "keyColor": "{{colors.primary.dark.hex}}" },
        { "type": "gpu", "keyColor": "{{colors.primary.dark.hex}}" },
        { "type": "memory", "keyColor": "{{colors.error.dark.hex}}" },
        { "type": "disk", "keyColor": "{{colors.error.dark.hex}}" },
        { "type": "localip", "keyColor": "{{colors.outline.dark.hex}}" },
        { "type": "locale", "keyColor": "{{colors.outline.dark.hex}}" },
        "break",
        "colors"
    ]
}
