/* Generated by matugen -- @import-ed by the rofi theme (home/awesome.nix).
 * Edit ~/.config/matugen/awesome/templates/rofi-colors.rasi instead. */
* {
    bg: {{colors.surface.default.hex}};
    bg-alt: {{colors.surface_container_high.default.hex}};
    surface: {{colors.surface_container.default.hex}};
    border-color: {{colors.outline_variant.default.hex}};
    fg: {{colors.on_surface.default.hex}};
    fg-muted: {{colors.outline.default.hex}};
    accent: {{colors.primary.default.hex}};
    urgent: {{colors.error.default.hex}};
}
