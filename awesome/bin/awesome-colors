#!/usr/bin/env bash
# awesome-colors <image> | --random-once
#
# Awesome's counterpart of Hyprland's apply-colors: makes <image> the
# wallpaper and recolors the session from it. Runs matugen twice -- the
# shared config (GTK, kitty, starship, btop, Vesktop, ... -- the same files
# Hyprland renders) and then Awesome's own (~/.config/matugen/awesome.toml:
# borders, quickshell bar, rofi, dunst, alacritty, lock screen) -- then
# pushes the result into what's already running.
#
# --random-once picks a random image from $WALLPAPER_DIR, but only once
# per login: rc.lua runs it at every (re)start, and Super+Ctrl+R shouldn't
# reshuffle the wallpaper.

set -uo pipefail

cache=~/.cache/awesome
mkdir -p "$cache"

if [[ ${1:-} == --random-once ]]; then
    stamp=$cache/random-wallpaper-session
    [[ -n ${XDG_SESSION_ID:-} && $(cat "$stamp" 2>/dev/null) == "$XDG_SESSION_ID" ]] && exit 0
    printf '%s\n' "${XDG_SESSION_ID:-}" > "$stamp"
    dir=${WALLPAPER_DIR:-$HOME/.config/wallpapers}
    img=$(find -L "$dir" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            | shuf -n 1)
    if [[ -z $img ]]; then
        notify-send -u critical "awesome-colors" "No images found in $dir"
        exit 1
    fi
else
    img=$(realpath -e "${1:?usage: awesome-colors <image> | --random-once}") || exit 1
fi

printf '%s\n' "$img" > "$cache/current-wallpaper"

# --source-color-index: matugen refuses to guess between candidate colors
# without a terminal to prompt on, which is always the case here.
for config in ~/.config/matugen/config.toml ~/.config/matugen/awesome.toml; do
    if ! matugen image -q -m dark --source-color-index 0 -c "$config" "$img" </dev/null; then
        notify-send -u critical "awesome-colors" "matugen failed for $(basename "$img")"
        exit 1
    fi
done

# rc.lua's awesome_apply_theme(): re-reads theme.lua (colors + wallpaper)
# and repaints wallpapers and window borders. The quickshell bar watches
# its colors file itself; alacritty reloads its imported colors on its own.
awesome-client 'awesome_apply_theme()' >/dev/null 2>&1

for sock in /tmp/kitty-*; do
    [[ -S $sock ]] && kitty @ --to "unix:$sock" set-colors --all --configured ~/.config/kitty/colors.conf
done

dunstctl reload >/dev/null 2>&1

setsid -f lock-screen --prepare >/dev/null 2>&1

exit 0
