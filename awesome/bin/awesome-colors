#!/usr/bin/env bash
# awesome-colors <image> | --random-once
#
# The X sessions' counterpart of Hyprland's apply-colors: makes <image> the
# wallpaper and recolors the session from it with matugen
# (~/.config/matugen/awesome.toml: borders, quickshell bar, rofi, dunst,
# alacritty, the lock screen, GTK apps, starship, fastfetch, btop, Vesktop),
# then pushes the result into what's already running.
#
# --random-once picks a random image from $WALLPAPER_DIR, but only once
# per login: the dwm session runs it at every start, and restarts shouldn't
# reshuffle the wallpaper.

set -uo pipefail

cache=~/.cache/awesome
mkdir -p "$cache"

if [[ ${1:-} == --random-once ]]; then
    # Session numbers start over after a reboot, so the boot ID goes with it.
    stamp=$cache/random-wallpaper-session
    login="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)/${XDG_SESSION_ID:-}"
    [[ -n ${XDG_SESSION_ID:-} && $(cat "$stamp" 2>/dev/null) == "$login" ]] && exit 0
    printf '%s\n' "$login" > "$stamp"
    dir=${WALLPAPER_DIR:-$HOME/.config/wallpapers}
    img=$(find -L "$dir" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
            | shuf -n 1)
    if [[ -z $img ]]; then
        notify-send -u critical "awesome-colors" "No images found in $dir"
        exit 1
    fi
else
    img=$(realpath -e "${1:?usage: awesome-colors <image> | --random-once}") || exit 1
fi

printf '%s\n' "$img" > "$cache/current-wallpaper"

# --source-color-index: matugen refuses to guess between candidate colors
# without a terminal to prompt on, which is always the case here.
if ! matugen image -q -m dark --source-color-index 0 -c ~/.config/matugen/awesome.toml "$img" </dev/null; then
    notify-send -u critical "awesome-colors" "matugen failed for $(basename "$img")"
    exit 1
fi

# The wallpaper: on Wayland (dwl), swaybg draws it and reads
# current-wallpaper when it starts (../../home/dwl.nix), so restart it. On
# X (dwm), set it on every monitor, merge dwm's new colors, and restart a
# running dwm in place (restartsig keeps its windows) so it reads them. The
# quickshell bar watches its colors file itself; alacritty reloads its
# imported colors on its own.
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    # try-restart: only if it's already running. At login this runs
    # before swaybg starts (dwl-random-wallpaper), which then just starts
    # with the new image; --no-block so the two never wait on each other.
    systemctl --user --no-block try-restart dwl-wallpaper.service
else
    xwallpaper --zoom "$img" 2>/dev/null
    [[ -e $cache/dwm.Xresources ]] && xrdb -merge "$cache/dwm.Xresources"
    pkill -HUP -x dwm
fi

for sock in /tmp/kitty-*; do
    [[ -S $sock ]] && kitty @ --to "unix:$sock" set-colors --all --configured ~/.config/kitty/colors.conf
done

# Only the notification daemon that's running: dunstctl alone would start
# dunst through D-Bus in dwl, where swaync holds the notifications.
pgrep -x dunst >/dev/null && dunstctl reload >/dev/null 2>&1
pgrep -x swaync >/dev/null && swaync-client --reload-css >/dev/null 2>&1

setsid -f lock-screen --prepare >/dev/null 2>&1

exit 0
